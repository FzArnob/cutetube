<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the PyInstaller folder (uploaded as a zip by the release workflow).
     Signs CuteTube's own executable; the bundled Python runtime files are third-party and keep their own signatures. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="CuteTube.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
